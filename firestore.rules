rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ─────────────────────────────────────────────
    // Each user can only read and write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Campus locations ──────────────────────────────────────────
    // Any authenticated user can read campus locations.
    // Only server-side / admin writes are allowed (no client writes).
    match /locations/{locationId} {
      allow read: if request.auth != null;
      // Write blocked from client; locations are seeded server-side.
      allow write: if false;
    }

    // ── Deny everything else ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
