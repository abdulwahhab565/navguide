<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permissions ───────────────────────────────────────────── -->
    <!-- Internet access for Firebase, Google Maps API, and routing -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- GPS / Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Foreground service for background location tracking during navigation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Network state for connectivity check -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:label="NavGuide"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- ── Google Maps API Key ─────────────────────────────── -->
        <!-- Replace YOUR_GOOGLE_MAPS_API_KEY with your actual key  -->
        <!-- Restrict key to: Maps SDK for Android + Directions API -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCpMjOU83HIUWrZVG46mDf4p7I3Z4nxXrE"/>

        <!-- Main activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- App entry point -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Do not delete the meta-data below — Flutter needs it -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>

    <!-- Required to query Activities if the app is targeting Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

</manifest>
